{"$schema":"https://docs.renovatebot.com/renovate-schema.json","addLabels":["renovate"],"extends":["config:recommended"],"labels":["dependencies"],"osvVulnerabilityAlerts":true,"packageRules":[{"description":"Terraform (github-repo-management) owns these distributed workflow files; Renovate must not edit them or it fights Terraform over the same content.","enabled":false,"matchFileNames":[".github/workflows/ai-triage.yml",".github/workflows/ai-fix.yml",".github/workflows/ai-review.yml",".github/workflows/auto-merge.yml",".github/workflows/codeql.yml",".github/workflows/digest.yml",".github/workflows/drift.yml"]},{"automerge":true,"matchUpdateTypes":["patch","minor"]},{"automerge":false,"labels":["dependencies","major-update"],"matchUpdateTypes":["major"]},{"description":"Enable Go toolchain (go directive) updates in go.mod; Renovate does not propose these by default.","groupName":"go toolchain","matchDepNames":["go"],"matchDepTypes":["golang"],"matchManagers":["gomod"],"rangeStrategy":"bump"},{"description":"Keep the Dockerfile golang image on the same Go version as go.mod by grouping it with the go directive.","groupName":"go toolchain","matchDepNames":["golang"],"matchManagers":["dockerfile"]}],"platformAutomerge":false,"prConcurrentLimit":5,"schedule":["every weekend"],"semanticCommitScope":"deps","semanticCommitType":"fix","semanticCommits":"enabled","vulnerabilityAlerts":{"automerge":true,"enabled":true,"labels":["dependencies","security"],"schedule":["at any time"]}}